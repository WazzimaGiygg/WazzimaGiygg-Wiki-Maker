rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3: Global hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedBureaucrat() {
      return isVerified() && request.auth.token.email == 'mafersao1100@gmail.com';
    }

    function isTargetBootstrappedBureaucrat(targetUid) {
      return exists(/databases/$(database)/documents/users/$(targetUid)/private/info) &&
        get(/databases/$(database)/documents/users/$(targetUid)/private/info).data.email == 'mafersao1100@gmail.com';
    }

    function isNotBlocked() {
      return isBootstrappedBureaucrat() || (
        isSignedIn() &&
        !exists(/databases/$(database)/documents/blocked_users/$(request.auth.uid))
      );
    }

    function isBureaucrat() {
      return isBootstrappedBureaucrat() || (
        isVerified() &&
        !exists(/databases/$(database)/documents/blocked_users/$(request.auth.uid)) &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'bureaucrat'
      );
    }

    function isAdmin() {
      return isBootstrappedBureaucrat() || (
        isVerified() &&
        !exists(/databases/$(database)/documents/blocked_users/$(request.auth.uid)) &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'bureaucrat']
      );
    }

    function canModerateTarget(targetUid) {
      return isVerified()
        && targetUid != request.auth.uid
        && !isTargetBootstrappedBureaucrat(targetUid)
        && (
          isBootstrappedBureaucrat() ||
          (!exists(/databases/$(database)/documents/admins/$(targetUid)) && isAdmin()) ||
          (exists(/databases/$(database)/documents/admins/$(targetUid)) &&
           get(/databases/$(database)/documents/admins/$(targetUid)).data.role != 'bureaucrat' &&
           isBureaucrat())
        );
    }

    function isUserOrDiscussionPage(slug, data) {
      return ('personal' in data.tags)
        || ('discussion' in data.tags)
        || slug.matches('^user-.*$')
        || slug.matches('^.*-discussion$');
    }

    // Pillar 5: Total Array Guarding (validates every bounded slot 0..7)
    function isValidTagItem(tag) {
      return tag is string && tag.size() >= 1 && tag.size() <= 32;
    }

    function isValidTagList(tags) {
      return tags is list
        && tags.size() <= 8
        && (tags.size() <= 0 || isValidTagItem(tags[0]))
        && (tags.size() <= 1 || isValidTagItem(tags[1]))
        && (tags.size() <= 2 || isValidTagItem(tags[2]))
        && (tags.size() <= 3 || isValidTagItem(tags[3]))
        && (tags.size() <= 4 || isValidTagItem(tags[4]))
        && (tags.size() <= 5 || isValidTagItem(tags[5]))
        && (tags.size() <= 6 || isValidTagItem(tags[6]))
        && (tags.size() <= 7 || isValidTagItem(tags[7]));
    }

    function isValidHeaderImageUrl(url) {
      return url is string
        && url.size() <= 200000
        && (
          url == '' ||
          (url.size() <= 1000 && url.matches('^https?://.*$')) ||
          url.matches('^data:image/(png|jpeg|jpg|webp|gif|avif);base64,[A-Za-z0-9+/=]+$')
        );
    }

    function isValidRecentEditorItem(item) {
      return item is map
        && item.keys().hasAll(['uid', 'name'])
        && item.keys().hasOnly(['uid', 'name'])
        && item.uid is string && isValidId(item.uid)
        && item.name is string && item.name.size() >= 1 && item.name.size() <= 80;
    }

    function isValidRecentEditorsList(editors) {
      return editors is list
        && editors.size() >= 1
        && editors.size() <= 3
        && (editors.size() <= 0 || isValidRecentEditorItem(editors[0]))
        && (editors.size() <= 1 || isValidRecentEditorItem(editors[1]))
        && (editors.size() <= 2 || isValidRecentEditorItem(editors[2]));
    }

    // Pillar 2: Validation Blueprints (never use existing() or diff() inside these helpers)
    function isValidWikiPage(data, slug) {
      return data.keys().hasAll([
          'slug', 'title', 'content', 'category', 'tags', 'visibility',
          'isLocked', 'authorId', 'authorName', 'lastEditorId',
          'lastEditorName', 'version', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'slug', 'title', 'content', 'category', 'tags', 'visibility',
          'isLocked', 'headerImageUrl', 'authorId', 'authorName', 'lastEditorId',
          'lastEditorName', 'recentEditors', 'version', 'createdAt', 'updatedAt'
        ])
        && data.slug is string && data.slug == slug && isValidId(data.slug)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.content is string && data.content.size() <= 200000
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40 && data.category.matches('^[a-z0-9\\-]+$')
        && isValidTagList(data.tags)
        && data.visibility in ['public', 'private']
        && data.isLocked is bool
        && (!('headerImageUrl' in data) || isValidHeaderImageUrl(data.headerImageUrl))
        && data.authorId is string && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.lastEditorId is string && isValidId(data.lastEditorId)
        && data.lastEditorName is string && data.lastEditorName.size() >= 1 && data.lastEditorName.size() <= 80
        && (!('recentEditors' in data) || isValidRecentEditorsList(data.recentEditors))
        && data.version is int && data.version >= 1 && data.version <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRevision(data, slug) {
      return data.keys().hasAll([
          'pageSlug', 'pageVisibility', 'pageAuthorId', 'title',
          'content', 'editorId', 'editorName', 'summary', 'version', 'createdAt'
        ])
        && data.keys().hasOnly([
          'pageSlug', 'pageVisibility', 'pageAuthorId', 'title',
          'content', 'editorId', 'editorName', 'summary', 'version', 'createdAt'
        ])
        && data.pageSlug is string && data.pageSlug == slug && isValidId(data.pageSlug)
        && data.pageVisibility in ['public', 'private']
        && data.pageAuthorId is string && isValidId(data.pageAuthorId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.content is string && data.content.size() <= 200000
        && data.editorId is string && isValidId(data.editorId)
        && data.editorName is string && data.editorName.size() >= 1 && data.editorName.size() <= 80
        && data.summary is string && data.summary.size() <= 200
        && data.version is int && data.version >= 1 && data.version <= 1000000
        && data.createdAt is timestamp;
    }

    function isValidComment(data, slug) {
      return data.keys().hasAll([
          'pageSlug', 'pageVisibility', 'pageAuthorId',
          'authorId', 'authorName', 'body', 'createdAt'
        ])
        && data.keys().hasOnly([
          'pageSlug', 'pageVisibility', 'pageAuthorId',
          'authorId', 'authorName', 'body', 'createdAt'
        ])
        && data.pageSlug is string && data.pageSlug == slug && isValidId(data.pageSlug)
        && data.pageVisibility in ['public', 'private']
        && data.pageAuthorId is string && isValidId(data.pageAuthorId)
        && data.authorId is string && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 2000
        && data.createdAt is timestamp;
    }

    function isValidPageRating(data, slug, userId) {
      return data.keys().hasAll([
          'pageSlug', 'pageVisibility', 'pageAuthorId',
          'userId', 'userName', 'score', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'pageSlug', 'pageVisibility', 'pageAuthorId',
          'userId', 'userName', 'score', 'createdAt', 'updatedAt'
        ])
        && data.pageSlug is string && data.pageSlug == slug && isValidId(data.pageSlug)
        && data.pageVisibility in ['public', 'private']
        && data.pageAuthorId is string && isValidId(data.pageAuthorId)
        && data.userId is string && isValidId(data.userId)
        && (data.userId == userId || data.userId == 'lgpd-anonymized')
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80
        && data.score is int && data.score >= 1 && data.score <= 5
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCollaborator(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'photoURL', 'personalPageSlug',
          'discussionPageSlug', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'personalPageSlug',
          'discussionPageSlug', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.photoURL is string && data.photoURL.size() <= 500
        && (data.photoURL == '' || data.photoURL.matches('^https?://.*$'))
        && data.personalPageSlug is string && isValidId(data.personalPageSlug)
        && data.discussionPageSlug is string && isValidId(data.discussionPageSlug)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserEdit(data, userId) {
      return data.keys().hasAll([
          'editorId', 'pageSlug', 'pageTitle', 'pageVisibility',
          'summary', 'version', 'createdAt'
        ])
        && data.keys().hasOnly([
          'editorId', 'pageSlug', 'pageTitle', 'pageVisibility',
          'summary', 'version', 'createdAt'
        ])
        && data.editorId is string && data.editorId == userId && isValidId(data.editorId)
        && data.pageSlug is string && isValidId(data.pageSlug)
        && data.pageTitle is string && data.pageTitle.size() >= 1 && data.pageTitle.size() <= 160
        && data.pageVisibility in ['public', 'private']
        && data.summary is string && data.summary.size() <= 200
        && data.version is int && data.version >= 1 && data.version <= 1000000
        && data.createdAt is timestamp;
    }

    function isValidWatchlistItem(data, userId, pageSlug) {
      return data.keys().hasAll([
          'userId', 'pageSlug', 'pageTitle', 'pageCategory', 'pageVisibility', 'createdAt'
        ])
        && data.keys().hasOnly([
          'userId', 'pageSlug', 'pageTitle', 'pageCategory', 'pageVisibility', 'createdAt'
        ])
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.pageSlug is string && data.pageSlug == pageSlug && isValidId(data.pageSlug)
        && data.pageTitle is string && data.pageTitle.size() >= 1 && data.pageTitle.size() <= 160
        && data.pageCategory is string && data.pageCategory.size() >= 1 && data.pageCategory.size() <= 40 && data.pageCategory.matches('^[a-z0-9\\-]+$')
        && data.pageVisibility in ['public', 'private']
        && data.createdAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, userId) {
      return data.keys().hasAll(['uid', 'role', 'grantedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'role', 'grantedBy', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.role in ['admin', 'bureaucrat']
        && data.grantedBy is string && isValidId(data.grantedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBlockedUser(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'reason', 'blockedBy', 'blockedByName', 'createdAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'reason', 'blockedBy', 'blockedByName', 'createdAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 300
        && data.blockedBy is string && isValidId(data.blockedBy)
        && data.blockedByName is string && data.blockedByName.size() >= 1 && data.blockedByName.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidLgpdLog(data) {
      return data.keys().hasAll(['targetUid', 'mode', 'summary', 'executedBy', 'executedByName', 'createdAt'])
        && data.keys().hasOnly(['targetUid', 'mode', 'summary', 'executedBy', 'executedByName', 'createdAt'])
        && data.targetUid is string && isValidId(data.targetUid)
        && data.mode in ['anonymize', 'purge']
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 300
        && data.executedBy is string && data.executedBy == request.auth.uid && isValidId(data.executedBy)
        && data.executedByName is string && data.executedByName.size() >= 1 && data.executedByName.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidExtensionSettings(settings) {
      return settings is map
        && settings.keys().hasOnly([
          'siteTitle', 'themeId', 'colorScheme', 'defaultExpanded', 'minHeadings',
          'footerTitle', 'showOutlineLink', 'allowEditorToolbar', 'allowAutoProfileCard',
          'showInNavbar', 'showInSidebar', 'excludeDiscussions', 'showInHeader',
          'showToastFeedback', 'notifyWhileEditing', 'allowAnonymousRead',
          'autoExitOnNavigate', 'externalLinkPrefix', 'encodeTargetUrl',
          'blazePlanConfirmed', 'maxUploadSizeMb', 'storageFolder'
        ])
        && (!('siteTitle' in settings) || (settings.siteTitle is string && settings.siteTitle.size() >= 1 && settings.siteTitle.size() <= 80))
        && (!('themeId' in settings) || (settings.themeId is string && settings.themeId.size() >= 1 && settings.themeId.size() <= 40 && settings.themeId.matches('^[a-z0-9\\-]+$')))
        && (!('colorScheme' in settings) || settings.colorScheme in ['user', 'light', 'dark'])
        && (!('defaultExpanded' in settings) || settings.defaultExpanded is bool)
        && (!('minHeadings' in settings) || (settings.minHeadings is int && settings.minHeadings >= 1 && settings.minHeadings <= 10))
        && (!('footerTitle' in settings) || (settings.footerTitle is string && settings.footerTitle.size() >= 1 && settings.footerTitle.size() <= 80))
        && (!('showOutlineLink' in settings) || settings.showOutlineLink is bool)
        && (!('allowEditorToolbar' in settings) || settings.allowEditorToolbar is bool)
        && (!('allowAutoProfileCard' in settings) || settings.allowAutoProfileCard is bool)
        && (!('showInNavbar' in settings) || settings.showInNavbar is bool)
        && (!('showInSidebar' in settings) || settings.showInSidebar is bool)
        && (!('excludeDiscussions' in settings) || settings.excludeDiscussions is bool)
        && (!('showInHeader' in settings) || settings.showInHeader is bool)
        && (!('showToastFeedback' in settings) || settings.showToastFeedback is bool)
        && (!('notifyWhileEditing' in settings) || settings.notifyWhileEditing is bool)
        && (!('allowAnonymousRead' in settings) || settings.allowAnonymousRead is bool)
        && (!('autoExitOnNavigate' in settings) || settings.autoExitOnNavigate is bool)
        && (!('externalLinkPrefix' in settings) || (
          settings.externalLinkPrefix is string
          && settings.externalLinkPrefix.size() <= 300
          && (
            settings.externalLinkPrefix == '' ||
            settings.externalLinkPrefix.matches('^https?://.*') ||
            (settings.externalLinkPrefix.matches('^/.*') && !settings.externalLinkPrefix.matches('^//.*'))
          )
        ))
        && (!('encodeTargetUrl' in settings) || settings.encodeTargetUrl is bool)
        && (!('blazePlanConfirmed' in settings) || settings.blazePlanConfirmed is bool)
        && (!('maxUploadSizeMb' in settings) || (settings.maxUploadSizeMb is int && settings.maxUploadSizeMb >= 1 && settings.maxUploadSizeMb <= 25))
        && (!('storageFolder' in settings) || (
          settings.storageFolder is string
          && settings.storageFolder.size() >= 1
          && settings.storageFolder.size() <= 64
          && settings.storageFolder.matches('^[a-z0-9][a-z0-9/_\\-]{0,62}$')
          && !settings.storageFolder.matches('.*//.*')
        ));
    }

    function isValidWikiExtension(data, extensionId) {
      return data.keys().hasAll([
          'id', 'scope', 'name', 'description', 'category', 'enabled',
          'sortOrder', 'settings', 'updatedBy', 'updatedByName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'scope', 'name', 'description', 'category', 'enabled',
          'sortOrder', 'settings', 'updatedBy', 'updatedByName', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == extensionId && isValidId(data.id)
        && data.scope == 'site'
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 300
        && data.category in ['appearance', 'reading', 'navigation', 'authoring', 'collaboration']
        && data.enabled is bool
        && data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 100
        && isValidExtensionSettings(data.settings)
        && data.updatedBy is string && isValidId(data.updatedBy)
        && data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUidList(uids) {
      return uids is list
        && uids.size() >= 1
        && uids.size() <= 8
        && (uids.size() <= 0 || isValidId(uids[0]))
        && (uids.size() <= 1 || isValidId(uids[1]))
        && (uids.size() <= 2 || isValidId(uids[2]))
        && (uids.size() <= 3 || isValidId(uids[3]))
        && (uids.size() <= 4 || isValidId(uids[4]))
        && (uids.size() <= 5 || isValidId(uids[5]))
        && (uids.size() <= 6 || isValidId(uids[6]))
        && (uids.size() <= 7 || isValidId(uids[7]));
    }

    function isValidSockpuppetCase(data, caseId) {
      return data.keys().hasAll([
          'id', 'title', 'masterUid', 'suspectedUids', 'evidenceSummary',
          'status', 'resolutionNotes', 'createdBy', 'createdByName',
          'updatedBy', 'updatedByName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'masterUid', 'suspectedUids', 'evidenceSummary',
          'status', 'resolutionNotes', 'createdBy', 'createdByName',
          'updatedBy', 'updatedByName', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == caseId && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.masterUid is string && isValidId(data.masterUid)
        && isValidUidList(data.suspectedUids)
        && data.evidenceSummary is string && data.evidenceSummary.size() >= 1 && data.evidenceSummary.size() <= 2000
        && data.status in ['open', 'confirmed', 'inconclusive', 'dismissed']
        && data.resolutionNotes is string && data.resolutionNotes.size() <= 1000
        && data.createdBy is string && isValidId(data.createdBy)
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 80
        && data.updatedBy is string && isValidId(data.updatedBy)
        && data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLgpdRequest(data, requestId) {
      return data.keys().hasAll([
          'id', 'requesterUid', 'requesterName', 'requestType', 'details',
          'status', 'resolutionNote', 'reviewedBy', 'reviewedByName',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'requesterUid', 'requesterName', 'requestType', 'details',
          'status', 'resolutionNote', 'reviewedBy', 'reviewedByName',
          'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == requestId && isValidId(data.id)
        && data.requesterUid is string && isValidId(data.requesterUid)
        && data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 80
        && data.requestType in ['anonymize', 'purge', 'access', 'correction']
        && data.details is string && data.details.size() >= 1 && data.details.size() <= 1000
        && data.status in ['pending', 'in-review', 'completed', 'rejected']
        && data.resolutionNote is string && data.resolutionNote.size() <= 500
        && data.reviewedBy is string && (data.reviewedBy == '' || isValidId(data.reviewedBy))
        && data.reviewedByName is string && data.reviewedByName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminDiscussionThread(data, threadId) {
      return data.keys().hasAll([
          'id', 'title', 'category', 'body', 'status', 'isPinned',
          'authorId', 'authorName', 'authorRole', 'replyCount',
          'createdAt', 'updatedAt', 'lastActivityAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'category', 'body', 'status', 'isPinned',
          'authorId', 'authorName', 'authorRole', 'replyCount',
          'createdAt', 'updatedAt', 'lastActivityAt'
        ])
        && data.id is string && data.id == threadId && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.category in ['general', 'sockpuppets', 'lgpd', 'policy', 'incident']
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 4000
        && data.status in ['open', 'resolved', 'archived']
        && data.isPinned is bool
        && data.authorId is string && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorRole in ['admin', 'bureaucrat']
        && data.replyCount is int && data.replyCount >= 0 && data.replyCount <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.lastActivityAt is timestamp;
    }

    function isValidAdminDiscussionPost(data, threadId) {
      return data.keys().hasAll([
          'threadId', 'authorId', 'authorName', 'authorRole', 'body', 'createdAt'
        ])
        && data.keys().hasOnly([
          'threadId', 'authorId', 'authorName', 'authorRole', 'body', 'createdAt'
        ])
        && data.threadId is string && data.threadId == threadId && isValidId(data.threadId)
        && data.authorId is string && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorRole in ['admin', 'bureaucrat']
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 2000
        && data.createdAt is timestamp;
    }

    function isImageUploadReady() {
      return exists(/databases/$(database)/documents/extensions/image-upload)
        && get(/databases/$(database)/documents/extensions/image-upload).data.enabled == true
        && 'blazePlanConfirmed' in get(/databases/$(database)/documents/extensions/image-upload).data.settings
        && get(/databases/$(database)/documents/extensions/image-upload).data.settings.blazePlanConfirmed == true;
    }

    function isValidWikiMediaAsset(data, mediaId) {
      return data.keys().hasAll([
          'id', 'scope', 'fileName', 'altText', 'downloadUrl', 'storagePath',
          'contentType', 'sizeBytes', 'width', 'height', 'pageSlug',
          'uploadedBy', 'uploadedByName', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'scope', 'fileName', 'altText', 'downloadUrl', 'storagePath',
          'contentType', 'sizeBytes', 'width', 'height', 'pageSlug',
          'uploadedBy', 'uploadedByName', 'createdAt'
        ])
        && data.id is string && data.id == mediaId && isValidId(data.id)
        && data.scope == 'site'
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 160
        && data.altText is string && data.altText.size() <= 200
        && data.downloadUrl is string && data.downloadUrl.size() >= 1 && data.downloadUrl.size() <= 1000 && data.downloadUrl.matches('^https://.*$')
        && data.storagePath is string && data.storagePath.size() >= 1 && data.storagePath.size() <= 300
        && data.contentType in ['image/png', 'image/jpeg', 'image/webp', 'image/gif', 'image/avif']
        && data.sizeBytes is int && data.sizeBytes >= 1 && data.sizeBytes <= 26214400
        && data.width is int && data.width >= 0 && data.width <= 16384
        && data.height is int && data.height >= 0 && data.height <= 16384
        && data.pageSlug is string && (data.pageSlug == '' || isValidId(data.pageSlug))
        && data.uploadedBy is string && isValidId(data.uploadedBy)
        && data.uploadedByName is string && data.uploadedByName.size() >= 1 && data.uploadedByName.size() <= 80
        && data.createdAt is timestamp;
    }

    // Collection: /pages/{slug}
    match /pages/{slug} {
      allow get: if isValidId(slug) && (
        (isVerified() && isNotBlocked() && resource == null) ||
        (resource != null && (
          existing().visibility == 'public' ||
          (isSignedIn() && existing().authorId == request.auth.uid) ||
          isAdmin()
        ))
      );

      allow list: if resource.data.visibility == 'public' ||
        (isSignedIn() && resource.data.authorId == request.auth.uid) ||
        isAdmin();

      // Pillar 10: Auth -> Static Validation -> DB Lookups
      allow create: if isVerified()
        && isValidId(slug)
        && isValidWikiPage(incoming(), slug)
        && incoming().authorId == request.auth.uid
        && incoming().lastEditorId == request.auth.uid
        && (!('recentEditors' in incoming()) || (incoming().recentEditors.size() == 1 && incoming().recentEditors[0].uid == request.auth.uid))
        && incoming().version == 1
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isNotBlocked();

      allow update: if isVerified()
        && isValidId(slug)
        && isValidWikiPage(incoming(), slug)
        && incoming().slug == existing().slug
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isNotBlocked()
        && (
          // Standard editorial / moderation update
          (
            incoming().version == existing().version + 1
            && incoming().authorId == existing().authorId
            && incoming().authorName == existing().authorName
            && incoming().lastEditorId == request.auth.uid
            && (!('recentEditors' in incoming()) || incoming().recentEditors[0].uid == request.auth.uid)
            && (
              // Tier 1: Page Author or Admin (full editorial + lock/visibility control; exclusive editor for user & discussion pages)
              (
                (existing().authorId == request.auth.uid || isAdmin())
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'title', 'content', 'category', 'tags', 'headerImageUrl', 'visibility', 'isLocked',
                  'lastEditorId', 'lastEditorName', 'recentEditors', 'version', 'updatedAt'
                ])
              ) ||
              // Tier 2: Collaborator on public unlocked non-personal/non-discussion page (content/metadata edits only)
              (
                existing().visibility == 'public'
                && existing().isLocked == false
                && !isUserOrDiscussionPage(slug, existing())
                && incoming().visibility == existing().visibility
                && incoming().isLocked == existing().isLocked
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'title', 'content', 'category', 'tags', 'headerImageUrl',
                  'lastEditorId', 'lastEditorName', 'recentEditors', 'version', 'updatedAt'
                ])
              )
            )
          ) ||
          // Tier Admin: LGPD Anonymization of author/lastEditor/recentEditors metadata without altering content
          (
            isAdmin()
            && incoming().version == existing().version
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'authorId', 'authorName', 'lastEditorId', 'lastEditorName', 'recentEditors', 'updatedAt'
            ])
            && ((incoming().authorId == existing().authorId && incoming().authorName == existing().authorName) || (incoming().authorId == 'lgpd-anonymized' && incoming().authorName == 'Removed User (LGPD)'))
            && ((incoming().lastEditorId == existing().lastEditorId && incoming().lastEditorName == existing().lastEditorName) || (incoming().lastEditorId == 'lgpd-anonymized' && incoming().lastEditorName == 'Removed User (LGPD)'))
          )
        );

      allow delete: if isVerified()
        && isValidId(slug)
        && isNotBlocked()
        && (existing().authorId == request.auth.uid || isAdmin());

      // Subcollection: /pages/{slug}/revisions/{revisionId}
      match /revisions/{revisionId} {
        allow get: if isValidId(slug) && isValidId(revisionId) && (
          existing().pageVisibility == 'public' ||
          (isSignedIn() && existing().pageAuthorId == request.auth.uid) ||
          isAdmin()
        );

        allow list: if resource.data.pageVisibility == 'public' ||
          (isSignedIn() && resource.data.pageAuthorId == request.auth.uid) ||
          isAdmin();

        allow create: if isVerified()
          && isValidId(slug)
          && isValidId(revisionId)
          && isValidRevision(incoming(), slug)
          && incoming().editorId == request.auth.uid
          && incoming().createdAt == request.time
          && revisionId == 'v_' + string(incoming().version)
          && isNotBlocked()
          && existsAfter(/databases/$(database)/documents/pages/$(slug))
          && incoming().pageVisibility == getAfter(/databases/$(database)/documents/pages/$(slug)).data.visibility
          && incoming().pageAuthorId == getAfter(/databases/$(database)/documents/pages/$(slug)).data.authorId
          && incoming().version == getAfter(/databases/$(database)/documents/pages/$(slug)).data.version
          && incoming().title == getAfter(/databases/$(database)/documents/pages/$(slug)).data.title
          && incoming().content == getAfter(/databases/$(database)/documents/pages/$(slug)).data.content
          && incoming().editorId == getAfter(/databases/$(database)/documents/pages/$(slug)).data.lastEditorId
          && getAfter(/databases/$(database)/documents/pages/$(slug)).data.updatedAt == request.time
          && (
            (getAfter(/databases/$(database)/documents/pages/$(slug)).data.visibility == 'public'
              && getAfter(/databases/$(database)/documents/pages/$(slug)).data.isLocked == false
              && !isUserOrDiscussionPage(slug, getAfter(/databases/$(database)/documents/pages/$(slug)).data)) ||
            getAfter(/databases/$(database)/documents/pages/$(slug)).data.authorId == request.auth.uid ||
            isAdmin()
          );

        allow update: if isVerified()
          && isValidId(slug)
          && isValidId(revisionId)
          && isValidRevision(incoming(), slug)
          && incoming().pageSlug == existing().pageSlug
          && incoming().version == existing().version
          && incoming().createdAt == existing().createdAt
          && isNotBlocked()
          && (
            (
              (existing().pageAuthorId == request.auth.uid || isAdmin())
              && incoming().diff(existing()).affectedKeys().hasOnly(['pageVisibility'])
              && existsAfter(/databases/$(database)/documents/pages/$(slug))
              && incoming().pageVisibility == getAfter(/databases/$(database)/documents/pages/$(slug)).data.visibility
            ) ||
            (
              isAdmin()
              && incoming().diff(existing()).affectedKeys().hasOnly(['editorId', 'editorName', 'pageAuthorId'])
              && ((incoming().editorId == existing().editorId && incoming().editorName == existing().editorName) || (incoming().editorId == 'lgpd-anonymized' && incoming().editorName == 'Removed User (LGPD)'))
              && (incoming().pageAuthorId == existing().pageAuthorId || incoming().pageAuthorId == 'lgpd-anonymized')
            )
          );

        allow delete: if isVerified()
          && isValidId(slug)
          && isValidId(revisionId)
          && isNotBlocked()
          && (existing().pageAuthorId == request.auth.uid || isAdmin());
      }

      // Subcollection: /pages/{slug}/comments/{commentId}
      match /comments/{commentId} {
        allow get: if isValidId(slug) && isValidId(commentId) && (
          existing().pageVisibility == 'public' ||
          (isSignedIn() && existing().pageAuthorId == request.auth.uid) ||
          isAdmin()
        );

        allow list: if resource.data.pageVisibility == 'public' ||
          (isSignedIn() && resource.data.pageAuthorId == request.auth.uid) ||
          isAdmin();

        allow create: if isVerified()
          && isValidId(slug)
          && isValidId(commentId)
          && isValidComment(incoming(), slug)
          && incoming().authorId == request.auth.uid
          && incoming().createdAt == request.time
          && isNotBlocked()
          && exists(/databases/$(database)/documents/pages/$(slug))
          && incoming().pageVisibility == get(/databases/$(database)/documents/pages/$(slug)).data.visibility
          && incoming().pageAuthorId == get(/databases/$(database)/documents/pages/$(slug)).data.authorId
          && (
            get(/databases/$(database)/documents/pages/$(slug)).data.visibility == 'public' ||
            get(/databases/$(database)/documents/pages/$(slug)).data.authorId == request.auth.uid ||
            isAdmin()
          );

        allow update: if isVerified()
          && isValidId(slug)
          && isValidId(commentId)
          && isValidComment(incoming(), slug)
          && incoming().pageSlug == existing().pageSlug
          && incoming().createdAt == existing().createdAt
          && isNotBlocked()
          && (
            (
              (existing().pageAuthorId == request.auth.uid || isAdmin())
              && incoming().diff(existing()).affectedKeys().hasOnly(['pageVisibility'])
              && existsAfter(/databases/$(database)/documents/pages/$(slug))
              && incoming().pageVisibility == getAfter(/databases/$(database)/documents/pages/$(slug)).data.visibility
            ) ||
            (
              isAdmin()
              && incoming().diff(existing()).affectedKeys().hasOnly(['authorId', 'authorName', 'pageAuthorId'])
              && ((incoming().authorId == existing().authorId && incoming().authorName == existing().authorName) || (incoming().authorId == 'lgpd-anonymized' && incoming().authorName == 'Removed User (LGPD)'))
              && (incoming().pageAuthorId == existing().pageAuthorId || incoming().pageAuthorId == 'lgpd-anonymized')
            )
          );

        allow delete: if isVerified()
          && isValidId(slug)
          && isValidId(commentId)
          && isNotBlocked()
          && (
            existing().authorId == request.auth.uid ||
            existing().pageAuthorId == request.auth.uid ||
            isAdmin()
          );
      }

      // Subcollection: /pages/{slug}/ratings/{userId}
      match /ratings/{userId} {
        allow get: if isValidId(slug) && isValidId(userId) && (
          (isVerified() && isNotBlocked() && isOwner(userId) && resource == null) ||
          (
            resource != null && (
              existing().pageVisibility == 'public' ||
              (isSignedIn() && (existing().pageAuthorId == request.auth.uid || existing().userId == request.auth.uid)) ||
              isAdmin()
            )
          )
        );

        allow list: if resource.data.pageVisibility == 'public' ||
          (isSignedIn() && (resource.data.pageAuthorId == request.auth.uid || resource.data.userId == request.auth.uid)) ||
          isAdmin();

        allow create: if isVerified()
          && isValidId(slug)
          && isValidId(userId)
          && isOwner(userId)
          && isValidPageRating(incoming(), slug, userId)
          && incoming().userId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isNotBlocked()
          && exists(/databases/$(database)/documents/pages/$(slug))
          && incoming().pageVisibility == get(/databases/$(database)/documents/pages/$(slug)).data.visibility
          && incoming().pageAuthorId == get(/databases/$(database)/documents/pages/$(slug)).data.authorId
          && (
            get(/databases/$(database)/documents/pages/$(slug)).data.visibility == 'public' ||
            get(/databases/$(database)/documents/pages/$(slug)).data.authorId == request.auth.uid ||
            isAdmin()
          );

        allow update: if isVerified()
          && isValidId(slug)
          && isValidId(userId)
          && isValidPageRating(incoming(), slug, userId)
          && incoming().pageSlug == existing().pageSlug
          && incoming().createdAt == existing().createdAt
          && isNotBlocked()
          && (
            (
              isOwner(userId)
              && incoming().userId == existing().userId
              && incoming().updatedAt == request.time
              && incoming().diff(existing()).affectedKeys().hasOnly(['score', 'userName', 'updatedAt'])
              && exists(/databases/$(database)/documents/pages/$(slug))
              && (
                get(/databases/$(database)/documents/pages/$(slug)).data.visibility == 'public' ||
                get(/databases/$(database)/documents/pages/$(slug)).data.authorId == request.auth.uid ||
                isAdmin()
              )
            ) ||
            (
              (existing().pageAuthorId == request.auth.uid || isAdmin())
              && incoming().diff(existing()).affectedKeys().hasOnly(['pageVisibility'])
              && existsAfter(/databases/$(database)/documents/pages/$(slug))
              && incoming().pageVisibility == getAfter(/databases/$(database)/documents/pages/$(slug)).data.visibility
            ) ||
            (
              isAdmin()
              && incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'userName', 'pageAuthorId'])
              && ((incoming().userId == existing().userId && incoming().userName == existing().userName) || (incoming().userId == 'lgpd-anonymized' && incoming().userName == 'Removed User (LGPD)'))
              && (incoming().pageAuthorId == existing().pageAuthorId || incoming().pageAuthorId == 'lgpd-anonymized')
            )
          );

        allow delete: if isVerified()
          && isValidId(slug)
          && isValidId(userId)
          && isNotBlocked()
          && (
            isOwner(userId) ||
            existing().pageAuthorId == request.auth.uid ||
            isAdmin()
          );
      }
    }

    // Collection: /collaborators/{userId} (Non-PII public profile)
    match /collaborators/{userId} {
      allow get: if isValidId(userId);
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidCollaborator(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isNotBlocked();

      allow update: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidCollaborator(incoming(), userId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isNotBlocked()
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']) ||
          (
            !('personalPageSlug' in existing())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'personalPageSlug', 'discussionPageSlug', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(userId) && canModerateTarget(userId);

      // Subcollection: /collaborators/{userId}/edits/{editId}
      match /edits/{editId} {
        allow get: if isValidId(userId) && isValidId(editId) && (
          existing().pageVisibility == 'public' ||
          (isSignedIn() && existing().editorId == request.auth.uid) ||
          isAdmin()
        );

        allow list: if resource.data.pageVisibility == 'public' ||
          (isSignedIn() && resource.data.editorId == request.auth.uid) ||
          isAdmin();

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(editId)
          && isOwner(userId)
          && isValidUserEdit(incoming(), userId)
          && incoming().createdAt == request.time
          && isNotBlocked()
          && existsAfter(/databases/$(database)/documents/collaborators/$(userId))
          && existsAfter(/databases/$(database)/documents/pages/$(incoming().pageSlug))
          && incoming().pageVisibility == getAfter(/databases/$(database)/documents/pages/$(incoming().pageSlug)).data.visibility
          && incoming().version == getAfter(/databases/$(database)/documents/pages/$(incoming().pageSlug)).data.version
          && incoming().pageTitle == getAfter(/databases/$(database)/documents/pages/$(incoming().pageSlug)).data.title
          && getAfter(/databases/$(database)/documents/pages/$(incoming().pageSlug)).data.lastEditorId == userId
          && getAfter(/databases/$(database)/documents/pages/$(incoming().pageSlug)).data.updatedAt == request.time;

        allow update: if isVerified()
          && isValidId(userId)
          && isValidId(editId)
          && isValidUserEdit(incoming(), userId)
          && incoming().editorId == existing().editorId
          && incoming().pageSlug == existing().pageSlug
          && incoming().version == existing().version
          && incoming().summary == existing().summary
          && incoming().createdAt == existing().createdAt
          && isNotBlocked()
          && (isOwner(userId) || isAdmin())
          && incoming().diff(existing()).affectedKeys().hasOnly(['pageVisibility', 'pageTitle'])
          && existsAfter(/databases/$(database)/documents/pages/$(existing().pageSlug))
          && incoming().pageVisibility == getAfter(/databases/$(database)/documents/pages/$(existing().pageSlug)).data.visibility
          && (
            incoming().pageTitle == existing().pageTitle ||
            incoming().pageTitle == getAfter(/databases/$(database)/documents/pages/$(existing().pageSlug)).data.title
          );

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(editId)
          && isNotBlocked()
          && (isOwner(userId) || canModerateTarget(userId));
      }

      // Subcollection: /collaborators/{userId}/watchlist/{pageSlug}
      match /watchlist/{pageSlug} {
        allow get: if isValidId(userId) && isValidId(pageSlug) && (
          isOwner(userId) || isAdmin()
        );

        allow list: if isSignedIn() && (
          resource.data.userId == request.auth.uid || isAdmin()
        );

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(pageSlug)
          && isOwner(userId)
          && isValidWatchlistItem(incoming(), userId, pageSlug)
          && incoming().createdAt == request.time
          && isNotBlocked()
          && exists(/databases/$(database)/documents/collaborators/$(userId))
          && exists(/databases/$(database)/documents/pages/$(pageSlug))
          && incoming().pageVisibility == get(/databases/$(database)/documents/pages/$(pageSlug)).data.visibility
          && (
            get(/databases/$(database)/documents/pages/$(pageSlug)).data.visibility == 'public' ||
            get(/databases/$(database)/documents/pages/$(pageSlug)).data.authorId == request.auth.uid ||
            isAdmin()
          );

        allow update: if false;

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(pageSlug)
          && isNotBlocked()
          && (isOwner(userId) || canModerateTarget(userId));
      }
    }

    // Collection: /users/{userId}/private/{docId} (Strict PII Isolation)
    match /users/{userId}/private/{docId} {
      allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isVerified()
        && isValidId(userId)
        && docId == 'info'
        && isOwner(userId)
        && isValidUserPrivateInfo(incoming(), userId)
        && incoming().updatedAt == request.time
        && isNotBlocked();

      allow update: if isVerified()
        && isValidId(userId)
        && docId == 'info'
        && isOwner(userId)
        && isValidUserPrivateInfo(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])
        && isNotBlocked();

      allow delete: if isValidId(userId) && isValidId(docId) && canModerateTarget(userId);
    }

    // Collection: /admins/{userId} (Managed exclusively by Bureaucrats; Primary Bureaucrat protected)
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isVerified()
        && isValidId(userId)
        && userId != request.auth.uid
        && isValidAdminRecord(incoming(), userId)
        && incoming().grantedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && !isTargetBootstrappedBureaucrat(userId)
        && isBureaucrat();

      allow update: if isVerified()
        && isValidId(userId)
        && userId != request.auth.uid
        && isValidAdminRecord(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().grantedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'grantedBy', 'updatedAt'])
        && !isTargetBootstrappedBureaucrat(userId)
        && isBureaucrat();

      allow delete: if isValidId(userId)
        && userId != request.auth.uid
        && !isTargetBootstrappedBureaucrat(userId)
        && isBureaucrat();
    }

    // Collection: /blocked_users/{userId} (Managed by Admins and Bureaucrats with tier protection)
    match /blocked_users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isVerified()
        && isValidId(userId)
        && isValidBlockedUser(incoming(), userId)
        && incoming().blockedBy == request.auth.uid
        && incoming().createdAt == request.time
        && canModerateTarget(userId);

      allow update: if isVerified()
        && isValidId(userId)
        && isValidBlockedUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().blockedBy == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'reason', 'blockedBy', 'blockedByName'])
        && canModerateTarget(userId);

      allow delete: if isValidId(userId) && canModerateTarget(userId);
    }

    // Collection: /lgpd_logs/{logId} (Immutable LGPD Compliance Audit Log)
    match /lgpd_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isVerified()
        && isValidId(logId)
        && isValidLgpdLog(incoming())
        && incoming().createdAt == request.time
        && canModerateTarget(incoming().targetUid);

      allow update: if false;
      allow delete: if false;
    }

    // Collection: /extensions/{extensionId} (Publicly loaded at site boot; writable exclusively by Bureaucrats)
    match /extensions/{extensionId} {
      allow get: if isValidId(extensionId) && (
        (isBureaucrat() && resource == null) ||
        (resource != null && (existing().scope == 'site' || isBureaucrat()))
      );

      allow list: if resource.data.scope == 'site' || isBureaucrat();

      allow create: if isVerified()
        && isValidId(extensionId)
        && isValidWikiExtension(incoming(), extensionId)
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isBureaucrat();

      allow update: if isVerified()
        && isValidId(extensionId)
        && isValidWikiExtension(incoming(), extensionId)
        && incoming().id == existing().id
        && incoming().scope == existing().scope
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().updatedBy == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'description', 'category', 'enabled', 'sortOrder',
          'settings', 'updatedBy', 'updatedByName', 'updatedAt'
        ])
        && isBureaucrat();

      allow delete: if isValidId(extensionId) && isBureaucrat();
    }

    // Collection: /sockpuppet_cases/{caseId} (Account verification & sockpuppet investigation files)
    match /sockpuppet_cases/{caseId} {
      allow get: if isValidId(caseId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isVerified()
        && isValidId(caseId)
        && isValidSockpuppetCase(incoming(), caseId)
        && incoming().createdBy == request.auth.uid
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();

      allow update: if isVerified()
        && isValidId(caseId)
        && isValidSockpuppetCase(incoming(), caseId)
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdByName == existing().createdByName
        && incoming().createdAt == existing().createdAt
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'masterUid', 'suspectedUids', 'evidenceSummary',
          'status', 'resolutionNotes', 'updatedBy', 'updatedByName', 'updatedAt'
        ])
        && isAdmin();

      allow delete: if isValidId(caseId) && isBureaucrat();
    }

    // Collection: /lgpd_requests/{requestId} (Formal LGPD data subject requests queue)
    match /lgpd_requests/{requestId} {
      allow get: if isValidId(requestId) && (
        (resource != null && (isOwner(existing().requesterUid) || isAdmin())) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (resource.data.requesterUid == request.auth.uid || isAdmin());

      allow create: if isVerified()
        && isValidId(requestId)
        && isValidLgpdRequest(incoming(), requestId)
        && incoming().status == 'pending'
        && incoming().resolutionNote == ''
        && incoming().reviewedBy == ''
        && incoming().reviewedByName == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isNotBlocked()
        && (incoming().requesterUid == request.auth.uid || isAdmin());

      allow update: if isVerified()
        && isValidId(requestId)
        && isValidLgpdRequest(incoming(), requestId)
        && incoming().id == existing().id
        && incoming().requesterUid == existing().requesterUid
        && incoming().requesterName == existing().requesterName
        && incoming().requestType == existing().requestType
        && incoming().details == existing().details
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().reviewedBy == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'resolutionNote', 'reviewedBy', 'reviewedByName', 'updatedAt'
        ])
        && isAdmin()
        && (existing().status in ['pending', 'in-review'] || isBureaucrat());

      allow delete: if isValidId(requestId) && isBureaucrat();
    }

    // Collection: /admin_discussions/{threadId} (Staff-only governance discussion area)
    match /admin_discussions/{threadId} {
      allow get: if isValidId(threadId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isVerified()
        && isValidId(threadId)
        && isValidAdminDiscussionThread(incoming(), threadId)
        && incoming().authorId == request.auth.uid
        && incoming().status == 'open'
        && incoming().replyCount == 0
        && (!incoming().isPinned || isBureaucrat())
        && incoming().authorRole == (isBureaucrat() ? 'bureaucrat' : 'admin')
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().lastActivityAt == request.time
        && isAdmin();

      allow update: if isVerified()
        && isValidId(threadId)
        && isValidAdminDiscussionThread(incoming(), threadId)
        && incoming().id == existing().id
        && incoming().authorId == existing().authorId
        && incoming().authorName == existing().authorName
        && incoming().authorRole == existing().authorRole
        && incoming().createdAt == existing().createdAt
        && isAdmin()
        && (
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['replyCount', 'lastActivityAt'])
            && incoming().replyCount == existing().replyCount + 1
            && incoming().lastActivityAt == request.time
          ) ||
          (
            (existing().authorId == request.auth.uid || isBureaucrat())
            && incoming().replyCount == existing().replyCount
            && incoming().updatedAt == request.time
            && (incoming().isPinned == existing().isPinned || isBureaucrat())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'category', 'body', 'status', 'isPinned', 'updatedAt'
            ])
          ) ||
          (
            incoming().replyCount == existing().replyCount
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if isValidId(threadId) && isAdmin() && (existing().authorId == request.auth.uid || isBureaucrat());

      // Subcollection: /admin_discussions/{threadId}/posts/{postId}
      match /posts/{postId} {
        allow get: if isValidId(threadId) && isValidId(postId) && isAdmin();
        allow list: if isAdmin();

        allow create: if isVerified()
          && isValidId(threadId)
          && isValidId(postId)
          && isValidAdminDiscussionPost(incoming(), threadId)
          && incoming().authorId == request.auth.uid
          && incoming().authorRole == (isBureaucrat() ? 'bureaucrat' : 'admin')
          && incoming().createdAt == request.time
          && isAdmin()
          && exists(/databases/$(database)/documents/admin_discussions/$(threadId))
          && getAfter(/databases/$(database)/documents/admin_discussions/$(threadId)).data.replyCount == get(/databases/$(database)/documents/admin_discussions/$(threadId)).data.replyCount + 1
          && getAfter(/databases/$(database)/documents/admin_discussions/$(threadId)).data.lastActivityAt == request.time;

        allow update: if false;

        allow delete: if isValidId(threadId) && isValidId(postId) && isAdmin() && (existing().authorId == request.auth.uid || isBureaucrat());
      }
    }

    // Collection: /wiki_media/{mediaId} (Uploaded Wiki image metadata; requires image-upload extension & Blaze confirmation)
    match /wiki_media/{mediaId} {
      allow get: if isValidId(mediaId);
      allow list: if resource.data.scope == 'site' || isAdmin();

      allow create: if isVerified()
        && isValidId(mediaId)
        && isValidWikiMediaAsset(incoming(), mediaId)
        && incoming().uploadedBy == request.auth.uid
        && incoming().createdAt == request.time
        && isNotBlocked()
        && isImageUploadReady();

      allow update: if isVerified()
        && isValidId(mediaId)
        && isValidWikiMediaAsset(incoming(), mediaId)
        && isAdmin()
        && incoming().id == existing().id
        && incoming().scope == existing().scope
        && incoming().fileName == existing().fileName
        && incoming().altText == existing().altText
        && incoming().downloadUrl == existing().downloadUrl
        && incoming().storagePath == existing().storagePath
        && incoming().contentType == existing().contentType
        && incoming().sizeBytes == existing().sizeBytes
        && incoming().width == existing().width
        && incoming().height == existing().height
        && incoming().pageSlug == existing().pageSlug
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['uploadedBy', 'uploadedByName'])
        && (
          (incoming().uploadedBy == existing().uploadedBy && incoming().uploadedByName == existing().uploadedByName) ||
          (incoming().uploadedBy == 'lgpd-anonymized' && incoming().uploadedByName == 'Removed User (LGPD)')
        );

      allow delete: if isVerified()
        && isValidId(mediaId)
        && isNotBlocked()
        && (existing().uploadedBy == request.auth.uid || isAdmin());
    }
  }
}
