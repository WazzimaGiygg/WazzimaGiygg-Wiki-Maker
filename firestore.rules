rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3: Global hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedBureaucrat() {
      return isVerified() && request.auth.token.email == 'mafersao1100@gmail.com';
    }

    function isTargetBootstrappedBureaucrat(targetUid) {
      return exists(/databases/$(database)/documents/users/$(targetUid)/private/info) &&
        get(/databases/$(database)/documents/users/$(targetUid)/private/info).data.email == 'mafersao1100@gmail.com';
    }

    function isNotBlocked() {
      return isBootstrappedBureaucrat() || (
        isSignedIn() &&
        !exists(/databases/$(database)/documents/blocked_users/$(request.auth.uid))
      );
    }

    function isBureaucrat() {
      return isBootstrappedBureaucrat() || (
        isVerified() &&
        !exists(/databases/$(database)/documents/blocked_users/$(request.auth.uid)) &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'bureaucrat'
      );
    }

    function isAdmin() {
      return isBootstrappedBureaucrat() || (
        isVerified() &&
        !exists(/databases/$(database)/documents/blocked_users/$(request.auth.uid)) &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'bureaucrat']
      );
    }

    function canModerateTarget(targetUid) {
      return isVerified()
        && targetUid != request.auth.uid
        && !isTargetBootstrappedBureaucrat(targetUid)
        && (
          isBootstrappedBureaucrat() ||
          (!exists(/databases/$(database)/documents/admins/$(targetUid)) && isAdmin()) ||
          (exists(/databases/$(database)/documents/admins/$(targetUid)) &&
           get(/databases/$(database)/documents/admins/$(targetUid)).data.role != 'bureaucrat' &&
           isBureaucrat())
        );
    }

    // Pillar 5: Total Array Guarding (validates every bounded slot 0..7)
    function isValidTagItem(tag) {
      return tag is string && tag.size() >= 1 && tag.size() <= 32;
    }

    function isValidTagList(tags) {
      return tags is list
        && tags.size() <= 8
        && (tags.size() <= 0 || isValidTagItem(tags[0]))
        && (tags.size() <= 1 || isValidTagItem(tags[1]))
        && (tags.size() <= 2 || isValidTagItem(tags[2]))
        && (tags.size() <= 3 || isValidTagItem(tags[3]))
        && (tags.size() <= 4 || isValidTagItem(tags[4]))
        && (tags.size() <= 5 || isValidTagItem(tags[5]))
        && (tags.size() <= 6 || isValidTagItem(tags[6]))
        && (tags.size() <= 7 || isValidTagItem(tags[7]));
    }

    // Pillar 2: Validation Blueprints (never use existing() or diff() inside these helpers)
    function isValidWikiPage(data, slug) {
      return data.keys().hasAll([
          'slug', 'title', 'content', 'category', 'tags', 'visibility',
          'isLocked', 'authorId', 'authorName', 'lastEditorId',
          'lastEditorName', 'version', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'slug', 'title', 'content', 'category', 'tags', 'visibility',
          'isLocked', 'authorId', 'authorName', 'lastEditorId',
          'lastEditorName', 'version', 'createdAt', 'updatedAt'
        ])
        && data.slug is string && data.slug == slug && isValidId(data.slug)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.content is string && data.content.size() <= 200000
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40 && data.category.matches('^[a-z0-9\\-]+$')
        && isValidTagList(data.tags)
        && data.visibility in ['public', 'private']
        && data.isLocked is bool
        && data.authorId is string && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.lastEditorId is string && isValidId(data.lastEditorId)
        && data.lastEditorName is string && data.lastEditorName.size() >= 1 && data.lastEditorName.size() <= 80
        && data.version is int && data.version >= 1 && data.version <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRevision(data, slug) {
      return data.keys().hasAll([
          'pageSlug', 'pageVisibility', 'pageAuthorId', 'title',
          'content', 'editorId', 'editorName', 'summary', 'version', 'createdAt'
        ])
        && data.keys().hasOnly([
          'pageSlug', 'pageVisibility', 'pageAuthorId', 'title',
          'content', 'editorId', 'editorName', 'summary', 'version', 'createdAt'
        ])
        && data.pageSlug is string && data.pageSlug == slug && isValidId(data.pageSlug)
        && data.pageVisibility in ['public', 'private']
        && data.pageAuthorId is string && isValidId(data.pageAuthorId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.content is string && data.content.size() <= 200000
        && data.editorId is string && isValidId(data.editorId)
        && data.editorName is string && data.editorName.size() >= 1 && data.editorName.size() <= 80
        && data.summary is string && data.summary.size() <= 200
        && data.version is int && data.version >= 1 && data.version <= 1000000
        && data.createdAt is timestamp;
    }

    function isValidComment(data, slug) {
      return data.keys().hasAll([
          'pageSlug', 'pageVisibility', 'pageAuthorId',
          'authorId', 'authorName', 'body', 'createdAt'
        ])
        && data.keys().hasOnly([
          'pageSlug', 'pageVisibility', 'pageAuthorId',
          'authorId', 'authorName', 'body', 'createdAt'
        ])
        && data.pageSlug is string && data.pageSlug == slug && isValidId(data.pageSlug)
        && data.pageVisibility in ['public', 'private']
        && data.pageAuthorId is string && isValidId(data.pageAuthorId)
        && data.authorId is string && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 2000
        && data.createdAt is timestamp;
    }

    function isValidCollaborator(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'photoURL', 'personalPageSlug',
          'discussionPageSlug', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'personalPageSlug',
          'discussionPageSlug', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.photoURL is string && data.photoURL.size() <= 500
        && (data.photoURL == '' || data.photoURL.matches('^https?://.*$'))
        && data.personalPageSlug is string && isValidId(data.personalPageSlug)
        && data.discussionPageSlug is string && isValidId(data.discussionPageSlug)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserEdit(data, userId) {
      return data.keys().hasAll([
          'editorId', 'pageSlug', 'pageTitle', 'pageVisibility',
          'summary', 'version', 'createdAt'
        ])
        && data.keys().hasOnly([
          'editorId', 'pageSlug', 'pageTitle', 'pageVisibility',
          'summary', 'version', 'createdAt'
        ])
        && data.editorId is string && data.editorId == userId && isValidId(data.editorId)
        && data.pageSlug is string && isValidId(data.pageSlug)
        && data.pageTitle is string && data.pageTitle.size() >= 1 && data.pageTitle.size() <= 160
        && data.pageVisibility in ['public', 'private']
        && data.summary is string && data.summary.size() <= 200
        && data.version is int && data.version >= 1 && data.version <= 1000000
        && data.createdAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, userId) {
      return data.keys().hasAll(['uid', 'role', 'grantedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'role', 'grantedBy', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.role in ['admin', 'bureaucrat']
        && data.grantedBy is string && isValidId(data.grantedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBlockedUser(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'reason', 'blockedBy', 'blockedByName', 'createdAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'reason', 'blockedBy', 'blockedByName', 'createdAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 300
        && data.blockedBy is string && isValidId(data.blockedBy)
        && data.blockedByName is string && data.blockedByName.size() >= 1 && data.blockedByName.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidLgpdLog(data) {
      return data.keys().hasAll(['targetUid', 'mode', 'summary', 'executedBy', 'executedByName', 'createdAt'])
        && data.keys().hasOnly(['targetUid', 'mode', 'summary', 'executedBy', 'executedByName', 'createdAt'])
        && data.targetUid is string && isValidId(data.targetUid)
        && data.mode in ['anonymize', 'purge']
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 300
        && data.executedBy is string && data.executedBy == request.auth.uid && isValidId(data.executedBy)
        && data.executedByName is string && data.executedByName.size() >= 1 && data.executedByName.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidExtensionSettings(settings) {
      return settings is map
        && settings.keys().hasOnly([
          'siteTitle', 'themeId', 'colorScheme', 'defaultExpanded', 'minHeadings',
          'footerTitle', 'showOutlineLink', 'allowEditorToolbar', 'allowAutoProfileCard',
          'showInNavbar', 'showInSidebar', 'excludeDiscussions', 'showInHeader',
          'showToastFeedback', 'notifyWhileEditing', 'allowAnonymousRead',
          'autoExitOnNavigate'
        ])
        && (!('siteTitle' in settings) || (settings.siteTitle is string && settings.siteTitle.size() >= 1 && settings.siteTitle.size() <= 80))
        && (!('themeId' in settings) || (settings.themeId is string && settings.themeId.size() >= 1 && settings.themeId.size() <= 40 && settings.themeId.matches('^[a-z0-9\\-]+$')))
        && (!('colorScheme' in settings) || settings.colorScheme in ['user', 'light', 'dark'])
        && (!('defaultExpanded' in settings) || settings.defaultExpanded is bool)
        && (!('minHeadings' in settings) || (settings.minHeadings is int && settings.minHeadings >= 1 && settings.minHeadings <= 10))
        && (!('footerTitle' in settings) || (settings.footerTitle is string && settings.footerTitle.size() >= 1 && settings.footerTitle.size() <= 80))
        && (!('showOutlineLink' in settings) || settings.showOutlineLink is bool)
        && (!('allowEditorToolbar' in settings) || settings.allowEditorToolbar is bool)
        && (!('allowAutoProfileCard' in settings) || settings.allowAutoProfileCard is bool)
        && (!('showInNavbar' in settings) || settings.showInNavbar is bool)
        && (!('showInSidebar' in settings) || settings.showInSidebar is bool)
        && (!('excludeDiscussions' in settings) || settings.excludeDiscussions is bool)
        && (!('showInHeader' in settings) || settings.showInHeader is bool)
        && (!('showToastFeedback' in settings) || settings.showToastFeedback is bool)
        && (!('notifyWhileEditing' in settings) || settings.notifyWhileEditing is bool)
        && (!('allowAnonymousRead' in settings) || settings.allowAnonymousRead is bool)
        && (!('autoExitOnNavigate' in settings) || settings.autoExitOnNavigate is bool);
    }

    function isValidWikiExtension(data, extensionId) {
      return data.keys().hasAll([
          'id', 'scope', 'name', 'description', 'category', 'enabled',
          'sortOrder', 'settings', 'updatedBy', 'updatedByName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'scope', 'name', 'description', 'category', 'enabled',
          'sortOrder', 'settings', 'updatedBy', 'updatedByName', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == extensionId && isValidId(data.id)
        && data.scope == 'site'
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 300
        && data.category in ['appearance', 'reading', 'navigation', 'authoring', 'collaboration']
        && data.enabled is bool
        && data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 100
        && isValidExtensionSettings(data.settings)
        && data.updatedBy is string && isValidId(data.updatedBy)
        && data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection: /pages/{slug}
    match /pages/{slug} {
      allow get: if isValidId(slug) && (
        (isVerified() && isNotBlocked() && resource == null) ||
        (resource != null && (
          existing().visibility == 'public' ||
          (isSignedIn() && existing().authorId == request.auth.uid) ||
          isAdmin()
        ))
      );

      allow list: if resource.data.visibility == 'public' ||
        (isSignedIn() && resource.data.authorId == request.auth.uid) ||
        isAdmin();

      // Pillar 10: Auth -> Static Validation -> DB Lookups
      allow create: if isVerified()
        && isValidId(slug)
        && isValidWikiPage(incoming(), slug)
        && incoming().authorId == request.auth.uid
        && incoming().lastEditorId == request.auth.uid
        && incoming().version == 1
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isNotBlocked();

      allow update: if isVerified()
        && isValidId(slug)
        && isValidWikiPage(incoming(), slug)
        && incoming().slug == existing().slug
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isNotBlocked()
        && (
          // Standard editorial / moderation update
          (
            incoming().version == existing().version + 1
            && incoming().authorId == existing().authorId
            && incoming().authorName == existing().authorName
            && incoming().lastEditorId == request.auth.uid
            && (
              // Tier 1: Page Author or Admin (full editorial + lock/visibility control)
              (
                (existing().authorId == request.auth.uid || isAdmin())
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'title', 'content', 'category', 'tags', 'visibility', 'isLocked',
                  'lastEditorId', 'lastEditorName', 'version', 'updatedAt'
                ])
              ) ||
              // Tier 2: Collaborator on public unlocked page (content/metadata edits only)
              (
                existing().visibility == 'public'
                && existing().isLocked == false
                && incoming().visibility == existing().visibility
                && incoming().isLocked == existing().isLocked
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'title', 'content', 'category', 'tags',
                  'lastEditorId', 'lastEditorName', 'version', 'updatedAt'
                ])
              )
            )
          ) ||
          // Tier Admin: LGPD Anonymization of author/lastEditor metadata without altering content
          (
            isAdmin()
            && incoming().version == existing().version
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'authorId', 'authorName', 'lastEditorId', 'lastEditorName', 'updatedAt'
            ])
            && ((incoming().authorId == existing().authorId && incoming().authorName == existing().authorName) || (incoming().authorId == 'lgpd-anonymized' && incoming().authorName == 'Removed User (LGPD)'))
            && ((incoming().lastEditorId == existing().lastEditorId && incoming().lastEditorName == existing().lastEditorName) || (incoming().lastEditorId == 'lgpd-anonymized' && incoming().lastEditorName == 'Removed User (LGPD)'))
          )
        );

      allow delete: if isVerified()
        && isValidId(slug)
        && isNotBlocked()
        && (existing().authorId == request.auth.uid || isAdmin());

      // Subcollection: /pages/{slug}/revisions/{revisionId}
      match /revisions/{revisionId} {
        allow get: if isValidId(slug) && isValidId(revisionId) && (
          existing().pageVisibility == 'public' ||
          (isSignedIn() && existing().pageAuthorId == request.auth.uid) ||
          isAdmin()
        );

        allow list: if resource.data.pageVisibility == 'public' ||
          (isSignedIn() && resource.data.pageAuthorId == request.auth.uid) ||
          isAdmin();

        allow create: if isVerified()
          && isValidId(slug)
          && isValidId(revisionId)
          && isValidRevision(incoming(), slug)
          && incoming().editorId == request.auth.uid
          && incoming().createdAt == request.time
          && revisionId == 'v_' + string(incoming().version)
          && isNotBlocked()
          && existsAfter(/databases/$(database)/documents/pages/$(slug))
          && incoming().pageVisibility == getAfter(/databases/$(database)/documents/pages/$(slug)).data.visibility
          && incoming().pageAuthorId == getAfter(/databases/$(database)/documents/pages/$(slug)).data.authorId
          && incoming().version == getAfter(/databases/$(database)/documents/pages/$(slug)).data.version
          && incoming().title == getAfter(/databases/$(database)/documents/pages/$(slug)).data.title
          && incoming().content == getAfter(/databases/$(database)/documents/pages/$(slug)).data.content
          && incoming().editorId == getAfter(/databases/$(database)/documents/pages/$(slug)).data.lastEditorId
          && getAfter(/databases/$(database)/documents/pages/$(slug)).data.updatedAt == request.time
          && (
            (getAfter(/databases/$(database)/documents/pages/$(slug)).data.visibility == 'public'
              && getAfter(/databases/$(database)/documents/pages/$(slug)).data.isLocked == false) ||
            getAfter(/databases/$(database)/documents/pages/$(slug)).data.authorId == request.auth.uid ||
            isAdmin()
          );

        allow update: if isVerified()
          && isValidId(slug)
          && isValidId(revisionId)
          && isValidRevision(incoming(), slug)
          && incoming().pageSlug == existing().pageSlug
          && incoming().version == existing().version
          && incoming().createdAt == existing().createdAt
          && isNotBlocked()
          && (
            (
              (existing().pageAuthorId == request.auth.uid || isAdmin())
              && incoming().diff(existing()).affectedKeys().hasOnly(['pageVisibility'])
              && existsAfter(/databases/$(database)/documents/pages/$(slug))
              && incoming().pageVisibility == getAfter(/databases/$(database)/documents/pages/$(slug)).data.visibility
            ) ||
            (
              isAdmin()
              && incoming().diff(existing()).affectedKeys().hasOnly(['editorId', 'editorName', 'pageAuthorId'])
              && ((incoming().editorId == existing().editorId && incoming().editorName == existing().editorName) || (incoming().editorId == 'lgpd-anonymized' && incoming().editorName == 'Removed User (LGPD)'))
              && (incoming().pageAuthorId == existing().pageAuthorId || incoming().pageAuthorId == 'lgpd-anonymized')
            )
          );

        allow delete: if isVerified()
          && isValidId(slug)
          && isValidId(revisionId)
          && isNotBlocked()
          && (existing().pageAuthorId == request.auth.uid || isAdmin());
      }

      // Subcollection: /pages/{slug}/comments/{commentId}
      match /comments/{commentId} {
        allow get: if isValidId(slug) && isValidId(commentId) && (
          existing().pageVisibility == 'public' ||
          (isSignedIn() && existing().pageAuthorId == request.auth.uid) ||
          isAdmin()
        );

        allow list: if resource.data.pageVisibility == 'public' ||
          (isSignedIn() && resource.data.pageAuthorId == request.auth.uid) ||
          isAdmin();

        allow create: if isVerified()
          && isValidId(slug)
          && isValidId(commentId)
          && isValidComment(incoming(), slug)
          && incoming().authorId == request.auth.uid
          && incoming().createdAt == request.time
          && isNotBlocked()
          && exists(/databases/$(database)/documents/pages/$(slug))
          && incoming().pageVisibility == get(/databases/$(database)/documents/pages/$(slug)).data.visibility
          && incoming().pageAuthorId == get(/databases/$(database)/documents/pages/$(slug)).data.authorId
          && (
            get(/databases/$(database)/documents/pages/$(slug)).data.visibility == 'public' ||
            get(/databases/$(database)/documents/pages/$(slug)).data.authorId == request.auth.uid ||
            isAdmin()
          );

        allow update: if isVerified()
          && isValidId(slug)
          && isValidId(commentId)
          && isValidComment(incoming(), slug)
          && incoming().pageSlug == existing().pageSlug
          && incoming().createdAt == existing().createdAt
          && isNotBlocked()
          && (
            (
              (existing().pageAuthorId == request.auth.uid || isAdmin())
              && incoming().diff(existing()).affectedKeys().hasOnly(['pageVisibility'])
              && existsAfter(/databases/$(database)/documents/pages/$(slug))
              && incoming().pageVisibility == getAfter(/databases/$(database)/documents/pages/$(slug)).data.visibility
            ) ||
            (
              isAdmin()
              && incoming().diff(existing()).affectedKeys().hasOnly(['authorId', 'authorName', 'pageAuthorId'])
              && ((incoming().authorId == existing().authorId && incoming().authorName == existing().authorName) || (incoming().authorId == 'lgpd-anonymized' && incoming().authorName == 'Removed User (LGPD)'))
              && (incoming().pageAuthorId == existing().pageAuthorId || incoming().pageAuthorId == 'lgpd-anonymized')
            )
          );

        allow delete: if isVerified()
          && isValidId(slug)
          && isValidId(commentId)
          && isNotBlocked()
          && (
            existing().authorId == request.auth.uid ||
            existing().pageAuthorId == request.auth.uid ||
            isAdmin()
          );
      }
    }

    // Collection: /collaborators/{userId} (Non-PII public profile)
    match /collaborators/{userId} {
      allow get: if isValidId(userId);
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidCollaborator(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isNotBlocked();

      allow update: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidCollaborator(incoming(), userId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isNotBlocked()
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']) ||
          (
            !('personalPageSlug' in existing())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'personalPageSlug', 'discussionPageSlug', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(userId) && canModerateTarget(userId);

      // Subcollection: /collaborators/{userId}/edits/{editId}
      match /edits/{editId} {
        allow get: if isValidId(userId) && isValidId(editId) && (
          existing().pageVisibility == 'public' ||
          (isSignedIn() && existing().editorId == request.auth.uid) ||
          isAdmin()
        );

        allow list: if resource.data.pageVisibility == 'public' ||
          (isSignedIn() && resource.data.editorId == request.auth.uid) ||
          isAdmin();

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(editId)
          && isOwner(userId)
          && isValidUserEdit(incoming(), userId)
          && incoming().createdAt == request.time
          && isNotBlocked()
          && existsAfter(/databases/$(database)/documents/collaborators/$(userId))
          && existsAfter(/databases/$(database)/documents/pages/$(incoming().pageSlug))
          && incoming().pageVisibility == getAfter(/databases/$(database)/documents/pages/$(incoming().pageSlug)).data.visibility
          && incoming().version == getAfter(/databases/$(database)/documents/pages/$(incoming().pageSlug)).data.version
          && incoming().pageTitle == getAfter(/databases/$(database)/documents/pages/$(incoming().pageSlug)).data.title
          && getAfter(/databases/$(database)/documents/pages/$(incoming().pageSlug)).data.lastEditorId == userId
          && getAfter(/databases/$(database)/documents/pages/$(incoming().pageSlug)).data.updatedAt == request.time;

        allow update: if isVerified()
          && isValidId(userId)
          && isValidId(editId)
          && isValidUserEdit(incoming(), userId)
          && incoming().editorId == existing().editorId
          && incoming().pageSlug == existing().pageSlug
          && incoming().version == existing().version
          && incoming().summary == existing().summary
          && incoming().createdAt == existing().createdAt
          && isNotBlocked()
          && (isOwner(userId) || isAdmin())
          && incoming().diff(existing()).affectedKeys().hasOnly(['pageVisibility', 'pageTitle'])
          && existsAfter(/databases/$(database)/documents/pages/$(existing().pageSlug))
          && incoming().pageVisibility == getAfter(/databases/$(database)/documents/pages/$(existing().pageSlug)).data.visibility
          && (
            incoming().pageTitle == existing().pageTitle ||
            incoming().pageTitle == getAfter(/databases/$(database)/documents/pages/$(existing().pageSlug)).data.title
          );

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(editId)
          && isNotBlocked()
          && (isOwner(userId) || canModerateTarget(userId));
      }
    }

    // Collection: /users/{userId}/private/{docId} (Strict PII Isolation)
    match /users/{userId}/private/{docId} {
      allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isVerified()
        && isValidId(userId)
        && docId == 'info'
        && isOwner(userId)
        && isValidUserPrivateInfo(incoming(), userId)
        && incoming().updatedAt == request.time
        && isNotBlocked();

      allow update: if isVerified()
        && isValidId(userId)
        && docId == 'info'
        && isOwner(userId)
        && isValidUserPrivateInfo(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])
        && isNotBlocked();

      allow delete: if isValidId(userId) && isValidId(docId) && canModerateTarget(userId);
    }

    // Collection: /admins/{userId} (Managed exclusively by Bureaucrats; Primary Bureaucrat protected)
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isVerified()
        && isValidId(userId)
        && userId != request.auth.uid
        && isValidAdminRecord(incoming(), userId)
        && incoming().grantedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && !isTargetBootstrappedBureaucrat(userId)
        && isBureaucrat();

      allow update: if isVerified()
        && isValidId(userId)
        && userId != request.auth.uid
        && isValidAdminRecord(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().grantedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'grantedBy', 'updatedAt'])
        && !isTargetBootstrappedBureaucrat(userId)
        && isBureaucrat();

      allow delete: if isValidId(userId)
        && userId != request.auth.uid
        && !isTargetBootstrappedBureaucrat(userId)
        && isBureaucrat();
    }

    // Collection: /blocked_users/{userId} (Managed by Admins and Bureaucrats with tier protection)
    match /blocked_users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isVerified()
        && isValidId(userId)
        && isValidBlockedUser(incoming(), userId)
        && incoming().blockedBy == request.auth.uid
        && incoming().createdAt == request.time
        && canModerateTarget(userId);

      allow update: if isVerified()
        && isValidId(userId)
        && isValidBlockedUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().blockedBy == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'reason', 'blockedBy', 'blockedByName'])
        && canModerateTarget(userId);

      allow delete: if isValidId(userId) && canModerateTarget(userId);
    }

    // Collection: /lgpd_logs/{logId} (Immutable LGPD Compliance Audit Log)
    match /lgpd_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isVerified()
        && isValidId(logId)
        && isValidLgpdLog(incoming())
        && incoming().createdAt == request.time
        && canModerateTarget(incoming().targetUid);

      allow update: if false;
      allow delete: if false;
    }

    // Collection: /extensions/{extensionId} (Publicly loaded at site boot; writable exclusively by Bureaucrats)
    match /extensions/{extensionId} {
      allow get: if isValidId(extensionId) && (
        (isBureaucrat() && resource == null) ||
        (resource != null && (existing().scope == 'site' || isBureaucrat()))
      );

      allow list: if resource.data.scope == 'site' || isBureaucrat();

      allow create: if isVerified()
        && isValidId(extensionId)
        && isValidWikiExtension(incoming(), extensionId)
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isBureaucrat();

      allow update: if isVerified()
        && isValidId(extensionId)
        && isValidWikiExtension(incoming(), extensionId)
        && incoming().id == existing().id
        && incoming().scope == existing().scope
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().updatedBy == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'description', 'category', 'enabled', 'sortOrder',
          'settings', 'updatedBy', 'updatedByName', 'updatedAt'
        ])
        && isBureaucrat();

      allow delete: if isValidId(extensionId) && isBureaucrat();
    }
  }
}
