{
  "entities": {
    "WikiPage": {
      "title": "WikiPage",
      "description": "A collaborative Markdown wiki page identified by a URL-safe slug.",
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "URL-safe page identifier matching document ID."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Display title of the wiki page."
        },
        "content": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200000,
          "description": "Markdown source content of the page."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-z0-9\\-]+$",
          "description": "Category slug for organizing the page."
        },
        "tags": {
          "type": "array",
          "description": "Bounded list of up to 8 short tags."
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "private"],
          "description": "Whether the page is public collaborative or private to the author."
        },
        "isLocked": {
          "type": "boolean",
          "description": "When true, only the original author or an admin can edit or delete."
        },
        "headerImageUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200000,
          "description": "Optional custom header banner image URL (HTTPS upload URL or optimized raster image data URL)."
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the user who created the page (immutable)."
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the original author."
        },
        "lastEditorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the user who made the latest edit."
        },
        "lastEditorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the most recent editor."
        },
        "version": {
          "type": "integer",
          "description": "Monotonically increasing revision number starting at 1."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of initial creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest revision."
        }
      },
      "required": [
        "slug",
        "title",
        "content",
        "category",
        "tags",
        "visibility",
        "isLocked",
        "authorId",
        "authorName",
        "lastEditorId",
        "lastEditorName",
        "version",
        "createdAt",
        "updatedAt"
      ]
    },
    "PageRevision": {
      "title": "PageRevision",
      "description": "Immutable historical snapshot of a wiki page edit.",
      "type": "object",
      "properties": {
        "pageSlug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "pageVisibility": {
          "type": "string",
          "enum": ["public", "private"]
        },
        "pageAuthorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "content": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200000
        },
        "editorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "editorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "version": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "pageSlug",
        "pageVisibility",
        "pageAuthorId",
        "title",
        "content",
        "editorId",
        "editorName",
        "summary",
        "version",
        "createdAt"
      ]
    },
    "PageComment": {
      "title": "PageComment",
      "description": "Collaborative discussion comment attached to a wiki page.",
      "type": "object",
      "properties": {
        "pageSlug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "pageVisibility": {
          "type": "string",
          "enum": ["public", "private"]
        },
        "pageAuthorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "pageSlug",
        "pageVisibility",
        "pageAuthorId",
        "authorId",
        "authorName",
        "body",
        "createdAt"
      ]
    },
    "PageRating": {
      "title": "PageRating",
      "description": "5-star reader rating for a wiki article, keyed by rater UID (one rating per user per page).",
      "type": "object",
      "properties": {
        "pageSlug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "pageVisibility": {
          "type": "string",
          "enum": ["public", "private"]
        },
        "pageAuthorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "5-star rating score from 1 to 5."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "pageSlug",
        "pageVisibility",
        "pageAuthorId",
        "userId",
        "userName",
        "score",
        "createdAt",
        "updatedAt"
      ]
    },
    "CollaboratorProfile": {
      "title": "CollaboratorProfile",
      "description": "Public display profile for wiki collaborators without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "photoURL": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "personalPageSlug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "discussionPageSlug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "photoURL",
        "personalPageSlug",
        "discussionPageSlug",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserEdit": {
      "title": "UserEdit",
      "description": "Record of a single wiki edit made by a collaborator, displayed on their personal page.",
      "type": "object",
      "properties": {
        "editorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "pageSlug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "pageTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "pageVisibility": {
          "type": "string",
          "enum": ["public", "private"]
        },
        "summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "version": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "editorId",
        "pageSlug",
        "pageTitle",
        "pageVisibility",
        "summary",
        "version",
        "createdAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Strictly private user PII isolated from public collaborator profiles.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted governance role record for wiki administrators and bureaucrats.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "bureaucrat"],
          "description": "Governance tier: admin or bureaucrat."
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "role", "grantedBy", "createdAt", "updatedAt"]
    },
    "BlockedUser": {
      "title": "BlockedUser",
      "description": "Moderation block record preventing a user from writing or editing wiki content.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "blockedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "blockedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "reason", "blockedBy", "blockedByName", "createdAt"]
    },
    "LgpdErasureLog": {
      "title": "LgpdErasureLog",
      "description": "Immutable LGPD data erasure audit entry containing no personal data.",
      "type": "object",
      "properties": {
        "targetUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mode": {
          "type": "string",
          "enum": ["anonymize", "purge"]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "executedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "executedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["targetUid", "mode", "summary", "executedBy", "executedByName", "createdAt"]
    },
    "WikiExtension": {
      "title": "WikiExtension",
      "description": "Site-wide wiki extension configuration managed exclusively by Bureaucrats and loaded at site boot.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique extension identifier matching the document ID."
        },
        "scope": {
          "type": "string",
          "enum": ["site"],
          "description": "Configuration scope loaded at wiki startup."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Human-readable name of the wiki extension."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Summary of what the extension adds or configures."
        },
        "category": {
          "type": "string",
          "enum": ["appearance", "reading", "navigation", "authoring", "collaboration"],
          "description": "Functional category of the extension."
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether the extension is active on the wiki."
        },
        "sortOrder": {
          "type": "integer",
          "description": "Display sort order in the Bureaucrat extension manager."
        },
        "settings": {
          "type": "object",
          "description": "Typed per-extension configuration options map (including siteTitle branding, themeId, colorScheme, externalLinkPrefix, and encodeTargetUrl)."
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the Bureaucrat who last updated this extension."
        },
        "updatedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the Bureaucrat who last updated this extension."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of initial extension configuration creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the most recent configuration update."
        }
      },
      "required": [
        "id",
        "scope",
        "name",
        "description",
        "category",
        "enabled",
        "sortOrder",
        "settings",
        "updatedBy",
        "updatedByName",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/pages/{slug}": {
      "schema": { "$ref": "#/entities/WikiPage" },
      "description": "Wiki pages keyed by URL-safe slug."
    },
    "/pages/{slug}/revisions/{revisionId}": {
      "schema": { "$ref": "#/entities/PageRevision" },
      "description": "Revision history snapshots for each wiki page."
    },
    "/pages/{slug}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/PageComment" },
      "description": "Discussion comments on each wiki page."
    },
    "/pages/{slug}/ratings/{userId}": {
      "schema": { "$ref": "#/entities/PageRating" },
      "description": "Per-user 5-star ratings for each wiki page."
    },
    "/collaborators/{userId}": {
      "schema": { "$ref": "#/entities/CollaboratorProfile" },
      "description": "Public collaborator profiles without PII."
    },
    "/collaborators/{userId}/edits/{editId}": {
      "schema": { "$ref": "#/entities/UserEdit" },
      "description": "Activity log of wiki edits authored by the collaborator."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Owner-only PII document."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Governance role records for admins and bureaucrats."
    },
    "/blocked_users/{userId}": {
      "schema": { "$ref": "#/entities/BlockedUser" },
      "description": "Blocked user records enforced by Firestore rules."
    },
    "/lgpd_logs/{logId}": {
      "schema": { "$ref": "#/entities/LgpdErasureLog" },
      "description": "Immutable LGPD data erasure compliance log."
    },
    "/extensions/{extensionId}": {
      "schema": { "$ref": "#/entities/WikiExtension" },
      "description": "Site-wide wiki extension configurations determined by Bureaucrats and loaded at site boot."
    }
  }
}
