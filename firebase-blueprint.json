{
  "entities": {
    "WikiPage": {
      "title": "WikiPage",
      "description": "A collaborative Markdown wiki page identified by a URL-safe slug.",
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "URL-safe page identifier matching document ID."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Display title of the wiki page."
        },
        "content": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200000,
          "description": "Markdown source content of the page."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-z0-9\\-]+$",
          "description": "Category slug for organizing the page."
        },
        "tags": {
          "type": "array",
          "description": "Bounded list of up to 8 short tags."
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "private"],
          "description": "Whether the page is public collaborative or private to the author."
        },
        "isLocked": {
          "type": "boolean",
          "description": "When true, only the original author or an admin can edit or delete."
        },
        "headerImageUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200000,
          "description": "Optional custom header banner image URL (HTTPS upload URL or optimized raster image data URL)."
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the user who created the page (immutable)."
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the original author."
        },
        "lastEditorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the user who made the latest edit."
        },
        "lastEditorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the most recent editor."
        },
        "recentEditors": {
          "type": "array",
          "description": "Bounded list of up to 3 most recent unique editors ({ uid, name }), ordered newest-first."
        },
        "version": {
          "type": "integer",
          "description": "Monotonically increasing revision number starting at 1."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of initial creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest revision."
        }
      },
      "required": [
        "slug",
        "title",
        "content",
        "category",
        "tags",
        "visibility",
        "isLocked",
        "authorId",
        "authorName",
        "lastEditorId",
        "lastEditorName",
        "version",
        "createdAt",
        "updatedAt"
      ]
    },
    "PageRevision": {
