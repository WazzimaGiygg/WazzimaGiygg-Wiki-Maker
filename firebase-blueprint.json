        },
        "updatedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the Bureaucrat who last updated this extension."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of initial extension configuration creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the most recent configuration update."
        }
      },
